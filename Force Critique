include('blacklist')

function beforeFight() {
	if (getFightType() == FIGHT_TYPE_SOLO) {
		var list = jsonDecode(getRegister('blacklist'))
		var enemyName = getName(getNearestEnemy())
		if (contains(getRegister('blacklist'), enemyName)) {
			if (list[enemyName] == EFFECT_DAMAGE) {
				setLoadout('strengthAgilityBandage', false)
				debug("Force donc bandage")
			}
		}
	}
}

// @version:4
global AoeType_STARINVERTED = 'etoile_inversee';
global AoeType_STAR = 'etoile';
global AoeType_SQUARE = 'carre';
global AoeType_POINT = 'cercle';
global AoeType_PLUS = 'ligne';
global AoeType_LASER = 'ligne';
global AoeType_CROSS = 'diago';
global AoeType_CIRCLE = 'cercle';


class Cell {
	number;
	x;
	y;
	type;
	left;
	up;
	right;
	down;

	constructor(number, x, y, type) {
		this.number = number;
		this.x = x;
		this.y = y;
		this.type = type;
		this.left = null;
		this.up = null;
		this.right = null;
		this.down = null;
	}

	static init(cells) {
		for (var cellNumber in [0..612]) {
			var cell = cells[cellNumber];
			cell.left = cellNumber - 18 < 0 || getCellDistance(cellNumber, cellNumber - 18) > 1 ? null : cells[cellNumber - 18];
			cell.up = cellNumber - 17 < 0 || getCellDistance(cellNumber, cellNumber - 17) > 1 ? null : cells[cellNumber - 17];
			cell.right = cellNumber + 18 > 612 || getCellDistance(cellNumber, cellNumber + 18) > 1 ? null : cells[cellNumber + 18];
			cell.down = cellNumber + 17 > 612 || getCellDistance(cellNumber, cellNumber + 17) > 1 ? null : cells[cellNumber + 17];
		}
	}

	static initField() {
		var cells = [];

		for (var cellNumber in [0..612]) {
			var cell = new Cell(
				cellNumber,
				getCellX(cellNumber),
				getCellY(cellNumber),
				getCellContent(cellNumber)
			);
			push(cells, cell);
		}

		Cell.init(cells);

		return cells;
	}

	static getCellOf(entity) {
		return field[getCell(entity)];
	}

	static getCellFromCoordinates(x, y) {
		var cell = getCellFromXY(x, y);
		if (!cell) return null;
		return field[cell];
	}

	static getCellsByArea(center, aoeType, min, max, path = false) {
		if (min > max) return [];
		var cells = [];
		if (aoeType == AoeType_CIRCLE) {
			for (var x = -max; x <= max; x++) {
				for (var y = -max + abs(x); y <= max - abs(x); y++) {
					if (abs(x) + abs(y) < min) continue;
					var cell = Cell.getCellFromCoordinates(center.x + x, center.y + y);
					if (!cell || cell.type == CELL_OBSTACLE) continue;
					push(cells, cell);
				}
			}
		} else if (aoeType == AoeType_PLUS) {
			for (var xy = -max; xy <= max; xy++) {
				var cell1 = Cell.getCellFromCoordinates(center.x + xy, center.y);
				if (cell1 && getCellDistance(center.number, cell1.number) >= min && cell1.type != CELL_OBSTACLE) {
					push(cells, cell1);
				}
				var cell2 = Cell.getCellFromCoordinates(center.x, center.y + xy);
				if (cell2 && getCellDistance(center.number, cell2.number) >= min && cell2.type != CELL_OBSTACLE) {
					push(cells, cell2);
				}
			}

		} else if (aoeType == AoeType_SQUARE) {
			for (var x = -max; x <= max; x++) {
				for (var y = -max; y <= max; y++) {
					var cell = Cell.getCellFromCoordinates(center.x + x, center.y + y);
					if (!cell || abs(x) < min && abs(y) < min || cell.type == CELL_OBSTACLE) continue;
					push(cells, cell);
				}
			}
		}

		if (!path) return cells;
		var entity = getEntityOnCell(center.number);
		return arrayFilter(cells, (cell) => getPathLength(getCell(entity), cell.number) <= getMP(entity));
	}

	static getCellsToGo(entity = myLeek.id, min = 0, mp = getMP(entity)) {
		return Cell.getCellsByArea(field[getCell(entity)], AoeType_CIRCLE, min, mp, true);
	}

	static getFurthestCellDistanceFrom(cells, entity) {
		if (!count(cells)) return null;
		var fromCell = getCell(entity);

		var furthestCell = cells[0];
		var furthestCellDistance = getCellDistance(fromCell, cells[0].number);

		for (var cell in cells) {
			var cellDistance = getCellDistance(fromCell, cell.number);
			if (cellDistance > furthestCellDistance) {
				furthestCell = cell;
				furthestCellDistance = cellDistance;
			}
		}

		return furthestCell;
	}

	static getClosestCellDistanceTo(cells, target) {
		if (!count(cells)) return null;
		var bestCell = cells[0];
		var distance = getCellDistance(getCell(target), bestCell.number);

		for (var cell in cells) {
			var cellDistance = getCellDistance(cell.number, getCell(target));

			if (cellDistance < distance && cell.type == CELL_EMPTY) {
				bestCell = cell;
				distance = cellDistance;
			}
		}
		return bestCell;
	}

	static getClosestCellPathTo(cells, entity) {
		if (!count(cells)) return null;
		var ofCell = getCell(entity);

		var closestCell = cells[0];
		var closestCellPathLength = getPathLength(ofCell, cells[0].number);

		for (var cell in cells) {
			var cellPathLength = getPathLength(ofCell, cell.number);
			if (cellPathLength == null) continue;
			if (cellPathLength < closestCellPathLength || closestCellPathLength == null) {
				closestCell = cell;
				closestCellPathLength = cellPathLength;
			}
		}

		return closestCell;
	}

	static visibleCells(cellsToCheck, targetCell = getCell(myLeek.id)) {
		if (!count(cellsToCheck)) return [];

		return arrayFilter(cellsToCheck, (cell) => lineOfSight(cell.number, targetCell));
	}

	static hiddenCells(cellsToCheck, target = enemy.id) {
		if (!count(cellsToCheck)) return [];

		return arrayFilter(cellsToCheck, (cell) => !lineOfSight(cell.number, getCell(target)));
	}

	static getCellsInRange(cells, min, max, target = enemy.id) {
		return arrayFilter(cells, (cell) => getCellDistance(cell.number, getCell(target)) >= min && max <= getCellDistance(cell.number, getCell(target)));
	}

	static toCells(cells) {
		return arrayMap(cells, (cell) => cell.number);
	}

	string() {
		return "N°" + this.number;
	}
}

function distanceBetween(source, target) {
	return getCellDistance(getCell(source), getCell(target));
}

function pathDistanceBetween(source, target) {
	return getPathLength(getCell(source), getCell(target));
}

function distanceTo(entityId) {
	return getCellDistance(getCell(), getCell(entityId));
}

function getRandomColor() {
	return getColor(randInt(0, 255), randInt(0, 255), randInt(0, 255));
}

function findFirst(array, callback) {
	for (var object in array) {
		if (callback(object)) {
			return object;
		}
	}
	return null;
}


