// git/blacklist

global blacklist = getRegister('blacklist') ? jsonDecode(getRegister('blacklist')) : [: ]
global blacklist2 = getRegister('blacklist2') ? jsonDecode(getRegister('blacklist2')) : [: ]

// Classification force / poison : une seule fois, au premier tour
if (getTurn() == 1) {
	var leeks = arrayFilter(arrayConcat(getEnemies(), getAllies()), (entity) => getType(entity) == ENTITY_LEEK && entity != getEntity() && getLevel(entity) == 301)

	arrayIter(leeks, leek => registerOrUpdateLeek(leek))

	if (!setRegister('blacklist', jsonEncode(blacklist))) {
		setRegister('blacklist2', jsonEncode(blacklist2))
	}
}

function registerOrUpdateLeek(leek) {
	var name = getName(leek)
	var type = getLeekEffectType(leek)
	blacklist[name] = type
	if (length(jsonEncode(blacklist)) > 5000) {
		blacklist2[name] = type
	}

	var label = "inconnu"
	if (type == EFFECT_DAMAGE) {
		label = "FORCE"
	} else if (type == EFFECT_POISON) {
		label = "POISON"
	}
	debug(name + " : " + label)
}

function getLeekEffectType(leek) {
	if (getMagic(leek) >= 400) return EFFECT_POISON
	if (getStrength(leek) >= 400) return EFFECT_DAMAGE
}